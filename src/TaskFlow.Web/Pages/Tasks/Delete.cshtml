@page "{id:int}"
@model TaskFlow.Web.Pages.Tasks.DeleteModel
@{
    ViewData["Title"] = "Delete task";
}
<section class="page-head">
    <div>
        <h1>Delete task</h1>
        <p class="subtitle">Confirm removal from the database.</p>
    </div>
    <a class="btn" href="/Tasks">Back</a>
</section>

<section class="panel">
    <div class="confirm">
        <p>Delete <strong>@Model.TaskItem!.Title</strong>?</p>
        <form method="post" class="actions">
            <button class="btn btn-danger" type="submit">Delete</button>
            <a class="btn" href="/Tasks/Details/@Model.TaskItem.Id">Cancel</a>
        </form>
    </div>
</section>
